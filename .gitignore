# Local environment variables and API keys; keep a placeholder template trackable.
.env
.env.*
!.env.example
!.env.*.example
secrets/
*.pem
*.key

# Python virtual environments and generated bytecode.
.venv/
venv/
env/
__pycache__/
*.py[cod]

# Python build artifacts and package metadata.
build/
dist/
*.egg-info/
.eggs/

# Test, type-checking, and lint caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local runtime data: recordings, transcripts, summaries, and databases.
# Keep intentional fixtures or demo assets outside these directories.
data/
recordings/
transcripts/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
logs/
*.log

# Local editor and operating-system files.
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
